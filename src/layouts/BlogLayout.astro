---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description = siteConfig.description,
  backHref = "/",
  backLabel = "Back to home",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/+/g, "/")} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · {siteConfig.name}</title>
  </head>
  <body style="background-color: #34333a;">
    <Header />
    <main class="min-h-screen pt-28 pb-16 md:pt-36">
      <div class="max-w-6xl mx-auto px-6 lg:px-8 mb-6">
        <a
          href={backHref}
          class="inline-flex items-center gap-1 text-sm text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
          style={`--accent-color: ${siteConfig.accentColor}`}
        >
          &larr; {backLabel}
        </a>
      </div>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
