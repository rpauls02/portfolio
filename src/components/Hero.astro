  <div
    aria-hidden="true"
    class="absolute inset-0 [mask-image:radial-gradient(160%_130%_at_75%_15%,white,transparent_95%)]"
  >
    {scatteredIcons.map((icon) => (
      <svg
        viewBox="0 0 24 24"
        class="icon-glow absolute"
        style={`left: ${icon.xPct}%; top: ${icon.yPct}%; width: ${icon.size}px; height: ${icon.size}px; --rot: ${icon.rotation}deg; animation-duration: ${icon.glowDuration}s, ${icon.floatDuration}s; animation-delay: ${icon.glowDelay}s, ${icon.floatDelay}s;`}
        set:html={icon.body}
      />
    ))}
    {scatteredSymbols.map((sym) => (
      <span
        class="symbol-float absolute font-mono"
        style={`left: ${sym.xPct}%; top: ${sym.yPct}%; font-size: ${sym.fontSize}px; color: ${siteConfig.accentColor}; opacity: 0.2; --rot: ${sym.rotation}deg; animation-duration: ${sym.floatDuration}s; animation-delay: ${sym.floatDelay}s;`}
      >
        {sym.glyph}
      </span>
    ))}
  </div>
  </div>
  <div class="h-full max-w-6xl mx-auto px-6 lg:px-8 py-8 sm:py-12 md:py-24 flex items-center">
    <div>
