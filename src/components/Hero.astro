            </svg>
          </a>
      )
    }

    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-[18px] w-[18px] sm:h-[26px] sm:w-[26px] md:h-[30px] md:w-[30px]"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </>
          </svg>
        </a>
      )
    }
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  /* Firefly-style random glow: icons idle at the unhovered skill-tag color,
     then briefly flare to the hovered skill-tag color at unsynced intervals. */
  .icon-glow {
    color: color-mix(in srgb, var(--accent-color) 30%, transparent);
    animation-name: icon-glow, icon-float;
    animation-timing-function: ease-in-out, linear;
    animation-iteration-count: infinite, infinite;
  }

  @keyframes icon-glow {
    0%, 100% {
      color: color-mix(in srgb, var(--accent-color) 30%, transparent);
      filter: none;
    }
    8% {
      color: color-mix(in srgb, var(--accent-color) 75%, transparent);
      filter: drop-shadow(0 0 4px color-mix(in srgb, var(--accent-color) 50%, transparent));
    }
    18% {
      color: color-mix(in srgb, var(--accent-color) 30%, transparent);
      filter: none;
    }
  }

  /* Gentle drift so scattered icons/symbols feel alive, like fireflies
     wandering rather than sitting fixed in place. Icons declare both
     animations together on .icon-glow (see above) to avoid two classes
     fighting over the shared animation-* shorthand properties. */
  .symbol-float {
    animation-name: symbol-float;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @keyframes icon-float {
    0%, 100% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(0px, 0px); }
    12.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(4px, -6px); }
    25% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(7px, -2px); }
    37.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(5px, 4px); }
    50% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(0px, 7px); }
    62.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-5px, 4px); }
    75% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-7px, -2px); }
    87.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-4px, -6px); }
  }

  @keyframes symbol-float {
    0%, 100% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(0px, 0px); }
    12.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-5px, -5px); }
    25% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-8px, 1px); }
    37.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-5px, 6px); }
    50% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(0px, 8px); }
    62.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(5px, 6px); }
    75% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(8px, 1px); }
    87.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(5px, -5px); }
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }

</style>
