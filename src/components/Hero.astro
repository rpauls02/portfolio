---
import { siteConfig } from "../config";
import { skillIcons } from "../lib/skillIcons";
import simpleIcons from "@iconify-json/simple-icons/icons.json";
import mdiIcons from "@iconify-json/mdi/icons.json";

const iconSets: Record<string, any> = { "simple-icons": simpleIcons, mdi: mdiIcons };

function getIconBody(iconRef: string) {
  const [prefix, name] = iconRef.split(":");
  const icon = iconSets[prefix]?.icons?.[name];
  if (!icon) return null;
  return icon.body
    .replaceAll("currentColor", siteConfig.accentColor)
    .replaceAll(
      `fill="${siteConfig.accentColor}"`,
      `fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round"`
    );
}

const allSkills = Array.from(
  new Set([
    ...siteConfig.projects.flatMap((p) => p.skills || []),
    ...siteConfig.education.flatMap((e) => e.skills || []),
  ])
);
const heroIcons = allSkills
  .map((s) => skillIcons[s])
  .filter((ref): ref is string => !!ref && !!getIconBody(ref));
for (let i = heroIcons.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [heroIcons[i], heroIcons[j]] = [heroIcons[j], heroIcons[i]];
}
// Jittered-grid placement: one icon per cell so instances can never overlap.
const GRID_COLS = 10;
const GRID_ROWS = 6;
const cells = [];
for (let r = 0; r < GRID_ROWS; r++) {
  for (let c = 0; c < GRID_COLS; c++) cells.push({ c, r });
}
for (let i = cells.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [cells[i], cells[j]] = [cells[j], cells[i]];
}
const cellW = 100 / GRID_COLS;
const cellH = 100 / GRID_ROWS;
const SCATTER_COUNT = Math.min(44, cells.length);
const scatteredIcons = Array.from({ length: SCATTER_COUNT }, (_, i) => {
  const cell = cells[i];
  const jitterX = Math.random() * 0.6 + 0.2;
  const jitterY = Math.random() * 0.6 + 0.2;
  return {
    body: heroIcons.length ? getIconBody(heroIcons[i % heroIcons.length]) : null,
    xPct: Math.round(cell.c * cellW + jitterX * cellW),
    yPct: Math.round(cell.r * cellH + jitterY * cellH),
    size: Math.round(Math.random() * 6 + 18),
    rotation: Math.round(Math.random() * 60 - 30),
    glowDuration: (Math.random() * 5 + 5).toFixed(2),
    glowDelay: (-(Math.random() * 10)).toFixed(2),
    floatDuration: (Math.random() * 6 + 8).toFixed(2),
    floatDelay: (-(Math.random() * 14)).toFixed(2),
  };
}).filter((p) => p.body);

// Code-symbol glyphs, scattered the same way (reusing leftover grid cells
// so they never land on top of a skill icon).
const SYMBOL_GLYPHS = ["</>", "{}", "[]", "()", "<>", "::", "==", "++", ";", "=>"];
const symbolCells = cells.slice(SCATTER_COUNT, SCATTER_COUNT + SYMBOL_GLYPHS.length);
const scatteredSymbols = SYMBOL_GLYPHS.map((glyph, i) => {
  const cell = symbolCells[i % symbolCells.length];
  const jitterX = Math.random() * 0.6 + 0.2;
  const jitterY = Math.random() * 0.6 + 0.2;
  return {
    glyph,
    xPct: Math.round(cell.c * cellW + jitterX * cellW),
    yPct: Math.round(cell.r * cellH + jitterY * cellH),
    fontSize: Math.round(Math.random() * 6 + 18),
    rotation: Math.round(Math.random() * 40 - 20),
    floatDuration: (Math.random() * 6 + 8).toFixed(2),
    floatDelay: (-(Math.random() * 14)).toFixed(2),
  };
});
---

<div
  id="hero"
  class="relative isolate overflow-hidden py-24 md:h-screen"
  style={`--accent-color: ${siteConfig.accentColor}; background-color: #34333a;`}
