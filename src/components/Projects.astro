---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import { skillIcons } from "../lib/skillIcons";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const categories = hasProjects
  ? Array.from(new Set(siteConfig.projects.map((p) => p.category).filter(Boolean))).sort()
  : [];
const hasWipProjects = hasProjects && siteConfig.projects.some((p) => p.wip);
---

{
  hasProjects && (
    <section id="projects" class="py-8 sm:py-12 md:py-16 lg:py-24" style="background-color: #34333a;">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="flex flex-col gap-8 lg:gap-12">
          <div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-100">
              Projects
            </h2>
            <div
              class="w-full h-[5px] mt-3 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          {categories.length > 0 && (
            <div
              id="project-filters"
              class="flex flex-wrap gap-2 lg:-my-4"
              style={`--accent: ${siteConfig.accentColor};`}
            >
              <button type="button" class="filter-pill" data-filter="All" data-active="true">
                All
              </button>
              {categories.map((cat) => (
                <button type="button" class="filter-pill" data-filter={cat} data-active="false">
                  {cat}
                </button>
              ))}
              {hasWipProjects && (
                <button type="button" class="filter-pill" data-filter="Work in Progress" data-active="false">
                  Work in Progress
                </button>
              )}
            </div>
          )}

          <div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {siteConfig.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const linkProps = project.link
                  ? {
                      href: project.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <div class="group relative" data-project-card data-category={project.category} data-wip={project.wip ? "true" : "false"}>
                    <Component
                      {...linkProps}
                      class={`z-10 flex flex-col h-full relative overflow-hidden p-4 sm:p-5 rounded-xl border border-gray-500 transition-all duration-500 ease-out ${
                        project.link
                          ? "hover:border-gray-300 hover:-translate-y-1 hover:shadow-[0_20px_25px_-5px_rgba(0,0,0,0.3),0_0_25px_var(--card-glow)]"
                          : ""
                      }`}
                      style={`background-color: #44434D; --card-glow: color-mix(in srgb, ${siteConfig.accentColor} 35%, transparent);`}
                      onmouseenter={`
                        this.querySelector('.arrow-btn')?.style.setProperty('background-color', 'color-mix(in srgb, ${siteConfig.accentColor} 75%, transparent)');
                        this.querySelectorAll('.skill-tag').forEach(el => el.style.setProperty('background-color', 'color-mix(in srgb, ${siteConfig.accentColor} 75%, transparent)'));
                        this.querySelector('.accent-bar')?.style.setProperty('background-color', 'color-mix(in srgb, ${siteConfig.accentColor} 75%, transparent)');
                      `}
                      onmouseleave={`
                        this.querySelector('.arrow-btn')?.style.setProperty('background-color', 'color-mix(in srgb, ${siteConfig.accentColor} 40%, transparent)');
                        this.querySelectorAll('.skill-tag').forEach(el => el.style.setProperty('background-color', 'color-mix(in srgb, ${siteConfig.accentColor} 30%, transparent)'));
                        this.querySelector('.accent-bar')?.style.setProperty('background-color', 'color-mix(in srgb, ${siteConfig.accentColor} 30%, transparent)');
                      `}
                    >
                      {project.images && project.images.length > 1 ? (
                        <div
                          class="slideshow relative -mx-4 -mt-4 sm:-mx-5 sm:-mt-5 mb-3 w-[calc(100%+2rem)] sm:w-[calc(100%+2.5rem)] overflow-hidden"
                          data-slideshow
                        >
                          {project.images.map((src, i) => (
                            <img
                              src={`${import.meta.env.BASE_URL}/${src}`.replace(/\/+/g, "/")}
                              alt={`${project.name} screenshot ${i + 1} of ${project.images.length}`}
                              loading={i === 0 ? "eager" : "lazy"}
                              data-slide
                              class={`${i === 0 ? "relative block w-full h-auto" : "absolute inset-0 w-full h-full object-contain"} transition-opacity duration-700`}
                              style={`opacity: ${i === 0 ? 1 : 0};`}
                            />
                          ))}
                          <span role="button" tabindex="0" aria-label={`Previous ${project.name} screenshot`} data-prev class="slide-nav left-2">
                            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                          </span>
                          <span role="button" tabindex="0" aria-label={`Next ${project.name} screenshot`} data-next class="slide-nav right-2">
                            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
                          </span>
                          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-2 rounded-full bg-black/40 px-2.5 py-1.5">
                            {project.images.map((_, i) => (
                              <span
                                role="button"
                                tabindex="0"
                                aria-label={`Show ${project.name} screenshot ${i + 1}`}
                                data-dot={i}
                                class="slide-dot block w-2 h-2 rounded-full cursor-pointer transition-colors duration-300"
                                style={`background-color: ${i === 0 ? siteConfig.accentColor : "rgba(255,255,255,0.5)"}; --accent: ${siteConfig.accentColor};`}
                              />
                            ))}
                          </div>
                        </div>
                      ) : (project.image || project.images?.[0]) && (
                        <img
                          src={`${import.meta.env.BASE_URL}/${project.image || project.images?.[0]}`.replace(/\/+/g, "/")}
                          alt={`${project.name} preview`}
                          class="-mx-4 -mt-4 sm:-mx-5 sm:-mt-5 mb-3 max-w-none w-[calc(100%+2rem)] sm:w-[calc(100%+2.5rem)] h-auto"
                        />
                      )}

                      {project.link && (
                        <div
                          class="arrow-btn absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-xl text-white transition-all duration-300"
                          style={`background-color: color-mix(in srgb, ${siteConfig.accentColor} 40%, transparent);`}
                        >
                          <svg
                            class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="flex flex-col gap-3 flex-1">
                        <div>
                          <span
                            class="text-xs font-mono"
                            style={{ color: siteConfig.accentColor }}
                          >
                            0{index + 1}
                          </span>
                          <h3 class="text-base sm:text-lg font-bold text-gray-200 mt-0.5 pr-8">
                            {project.name}
                          </h3>
                          <div
                            class="accent-bar w-full h-[2px] mt-2 rounded-full transition-colors duration-300"
                            style={`background-color: color-mix(in srgb, ${siteConfig.accentColor} 30%, transparent)`}
                          />
                        </div>

                        <p class="text-sm sm:text-base text-gray-300 leading-relaxed flex-1">
                          {project.description}
                        </p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 pt-1">
                            {project.skills.map((skill) => (
                              <span
                                class="skill-tag flex items-center gap-1.5 px-2 py-1 rounded-md text-sm font-medium transition-all duration-300 text-gray-300"
                                style={`background-color: color-mix(in srgb, ${siteConfig.accentColor} 30%, transparent);`}
                              >
                                {skillIcons[skill] && (
                                  <Icon name={skillIcons[skill]} class="w-3.5 h-3.5 flex-shrink-0" />
                                )}
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .slide-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background-color: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.3s ease, background-color 0.3s ease;
  }
  .slideshow:hover .slide-nav,
  .slide-nav:focus-visible {
    opacity: 1;
  }
  .slide-nav:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }
  @media (hover: none) {
    .slide-nav {
      opacity: 0.85;
    }
  }
  .filter-pill {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #6b7280;
    color: #d1d5db;
    background-color: transparent;
    transition: all 0.3s ease;
  }
  .filter-pill:hover {
    border-color: var(--accent);
  }
  .filter-pill[data-active="true"] {
    background-color: var(--accent);
    border-color: var(--accent);
    color: white;
  }
</style>

<script>
  // Project image slideshows: crossfade every 4s, pause on hover, dots to jump.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-slideshow]").forEach((show) => {
    const slides = show.querySelectorAll<HTMLElement>("[data-slide]");
    const dots = show.querySelectorAll<HTMLElement>("[data-dot]");
    let current = 0;
    let timer: number | undefined;
    // Fetch the remaining slides in the background once the page has loaded,
    // so a slide is never shown before its image has arrived.
    const warm = () => slides.forEach((s) => s.setAttribute("loading", "eager"));
    if (document.readyState === "complete") warm();
    else window.addEventListener("load", warm, { once: true });
    const go = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => (s.style.opacity = i === current ? "1" : "0"));
      dots.forEach((d, i) =>
        d.style.setProperty("background-color", i === current ? d.style.getPropertyValue("--accent") : "rgba(255,255,255,0.5)")
      );
    };
    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => go(current + 1), 4000);
    };
    const stop = () => window.clearInterval(timer);
    dots.forEach((d) => {
      const pick = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        go(Number(d.dataset.dot));
      };
      d.addEventListener("click", pick);
      d.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") pick(e);
      });
    });
    const manual = (step: number) => (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      go(current + step);
    };
    show.querySelectorAll<HTMLElement>("[data-prev],[data-next]").forEach((btn) => {
      const handler = manual(btn.hasAttribute("data-prev") ? -1 : 1);
      btn.addEventListener("click", handler);
      btn.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") handler(e);
      });
    });
    // Swipe on touch screens; restart autoplay after a manual change.
    let touchX: number | null = null;
    show.addEventListener("touchstart", (e) => { touchX = e.touches[0].clientX; stop(); }, { passive: true });
    show.addEventListener("touchend", (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      touchX = null;
      if (Math.abs(dx) > 40) {
        e.preventDefault();
        go(current + (dx < 0 ? 1 : -1));
      }
      start();
    });
    show.addEventListener("mouseenter", stop);
    show.addEventListener("mouseleave", start);
    start();
  });

  const container = document.getElementById("project-filters");
  const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");

  container?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".filter-pill");
    if (!btn) return;

    container.querySelectorAll(".filter-pill").forEach((b) => b.setAttribute("data-active", "false"));
    btn.setAttribute("data-active", "true");

    const filter = btn.dataset.filter;
    cards.forEach((card) => {
      const show =
        filter === "All" ||
        card.dataset.category === filter ||
        (filter === "Work in Progress" && card.dataset.wip === "true");
      card.style.display = show ? "" : "none";
    });
  });
</script>