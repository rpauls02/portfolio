---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---
{
  hasExperience && (
    <section id="experience" class="py-8 sm:py-12 md:py-16 lg:py-24" style="background-color: #34333a;">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="flex flex-col gap-8 lg:gap-12">
          <div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-100">
              Experience
            </h2>
            <div
              class="w-full h-[5px] mt-3 rounded-xl"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>
          <div>
            <div class="relative">
              {siteConfig.experience.map((exp, index) => (
                <div class="relative mb-12 last:mb-0">
                  {/* Timeline dot at top of card */}
                  <div
                    class="absolute left-1/2 -top-2 w-4 h-4 border-2 rounded-xl -translate-x-1/2 z-20 transition-all duration-300"
                    style={`border-color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}`}
                  />
                  {/* Connecting line below card */}
                  {index < siteConfig.experience.length - 1 && (
                    <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-gray-600 -translate-x-1/2 translate-y-full z-10" />
                  )}
                  {/* Experience card */}
                  <div
                    class="relative z-10 rounded-lg border border-gray-500 p-4 sm:p-5 md:p-6 transition-all duration-500 ease-out hover:border-gray-300 hover:-translate-y-1 hover:shadow-[0_20px_25px_-5px_rgba(0,0,0,0.3),0_0_25px_var(--card-glow)]"
                    style={`background-color: #44434D; --card-glow: color-mix(in srgb, ${siteConfig.accentColor} 35%, transparent);`}
                    onmouseenter={`
                      this.querySelectorAll('.exp-highlight').forEach(el => el.style.setProperty('color', 'color-mix(in srgb, ${siteConfig.accentColor} 75%, white)'));
                      this.querySelector('.accent-bar')?.style.setProperty('background-color', 'color-mix(in srgb, ${siteConfig.accentColor} 75%, transparent)');
                      this.querySelector('.date-highlight')?.style.setProperty('color', '#e5e7eb');
                    `}
                    onmouseleave={`
                      this.querySelectorAll('.exp-highlight').forEach(el => el.style.setProperty('color', '${siteConfig.accentColor}'));
                      this.querySelector('.accent-bar')?.style.setProperty('background-color', 'color-mix(in srgb, ${siteConfig.accentColor} 30%, transparent)');
                      this.querySelector('.date-highlight')?.style.setProperty('color', '');
                    `}
                  >
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-2 gap-3">
                      <div>
                        <h3 class="text-lg sm:text-xl font-semibold text-gray-100">
                          {exp.title}
                        </h3>
                        <p
                          class="exp-highlight text-base sm:text-lg transition-colors duration-300"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {exp.company}
                        </p>
                      </div>
                      <span class="date-highlight text-xs sm:text-sm text-gray-400 sm:mt-0 transition-colors duration-300">
                        {exp.dateRange}
                      </span>
                    </div>
                    <div
                      class="accent-bar w-full h-[2px] mb-3 rounded-full transition-colors duration-300"
                      style={`background-color: color-mix(in srgb, ${siteConfig.accentColor} 30%, transparent)`}
                    />
                    <ul class="space-y-2">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-500 mt-2 mr-3 flex-shrink-0" />
                          <span class="text-sm sm:text-base text-gray-300">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}