---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

// Scattered code-symbol glyphs, jittered across a grid so they never overlap.
const FOOTER_SYMBOL_GLYPHS = ["</>", "{}", "[]", "()", "<>", "::", "==", "++", ";", "=>"];
const FOOTER_GRID_COLS = 5;
const FOOTER_GRID_ROWS = 3;
const footerCells = [];
for (let r = 0; r < FOOTER_GRID_ROWS; r++) {
  for (let c = 0; c < FOOTER_GRID_COLS; c++) footerCells.push({ c, r });
}
for (let i = footerCells.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [footerCells[i], footerCells[j]] = [footerCells[j], footerCells[i]];
}
const footerCellW = 100 / FOOTER_GRID_COLS;
const footerCellH = 100 / FOOTER_GRID_ROWS;
const scatteredFooterSymbols = FOOTER_SYMBOL_GLYPHS.map((glyph, i) => {
  const cell = footerCells[i % footerCells.length];
  const jitterX = Math.random() * 0.6 + 0.2;
  const jitterY = Math.random() * 0.6 + 0.2;
  return {
    glyph,
    xPct: Math.round(cell.c * footerCellW + jitterX * footerCellW),
    yPct: Math.round(cell.r * footerCellH + jitterY * footerCellH),
    fontSize: Math.round(Math.random() * 6 + 18),
    rotation: Math.round(Math.random() * 40 - 20),
    floatDuration: (Math.random() * 6 + 8).toFixed(2),
    floatDelay: (-(Math.random() * 14)).toFixed(2),
  };
});
---

<footer id="site-footer" class="relative overflow-hidden" style={`background-color: #34333a;`}>

  <!-- Decorative pattern (matches Hero background, fading in from the top) -->
  <div class="absolute inset-0 pointer-events-none [mask-image:linear-gradient(to_bottom,transparent,white_40%)]">
    <svg
      aria-hidden="true"
      class="absolute inset-0 size-full stroke-gray-700"
    >
      <defs>
        <pattern
          x="50%"
          y={-1}
          id="footer-grid-lines"
          width={200}
          height={200}
          patternUnits="userSpaceOnUse"
        >
          <path d="M.5 200V.5H200" fill="none" stroke-width="0.5"></path>
        </pattern>
        <pattern
          x="50%"
          y={-1}
          id="footer-grid-tile-fill"
          width={200}
          height={200}
          patternUnits="userSpaceOnUse"
        >
          <rect x="1" y="1" width="198" height="198" fill={siteConfig.accentColor}></rect>
        </pattern>
      </defs>
      <rect
        fill="url(#footer-grid-lines)"
        width="100%"
        height="100%"
        stroke-width={0}></rect>
      <rect
        id="footer-grid-spotlight"
        fill="url(#footer-grid-tile-fill)"
        width="100%"
        height="100%"></rect>
    </svg>
    {scatteredFooterSymbols.map((sym) => (
      <span
        class="symbol-float absolute font-mono"
        style={`left: ${sym.xPct}%; top: ${sym.yPct}%; font-size: ${sym.fontSize}px; color: ${siteConfig.accentColor}; opacity: 0.2; --rot: ${sym.rotation}deg; animation-duration: ${sym.floatDuration}s; animation-delay: ${sym.floatDelay}s;`}
      >
        {sym.glyph}
      </span>
    ))}
  </div>

  <div class="relative mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-8"
    >
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold" style={{ color: siteConfig.accentColor }}>
          {siteConfig.name}
        </h3>
        <p class="text-base text-gray-400">
          {siteConfig.title}
        </p>
        <div class="flex gap-x-6">
        {
          siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              aria-label="Email"
              class="text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
              style={`--accent-color: ${siteConfig.accentColor}`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path
                  d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"
                ></path>
                <path d="M3 7l9 6l9 -6"></path>
              </svg>
            </a>
          )
        }

        {
          siteConfig.social?.linkedin && (
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
            style={`--accent-color: ${siteConfig.accentColor}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-5"
              ></path><path d="M16 16v-3a2 2 0 1 0 -4 0"></path><path
                d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"
              ></path></svg
            >
          </a>
          )
        }

        {
          siteConfig.social?.twitter && (
          <a
            href={siteConfig.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter"
            class="text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
            style={`--accent-color: ${siteConfig.accentColor}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path
                d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg
            >
          </a>
          )
        }

        {
          siteConfig.social?.discord && (
          <a
            href={siteConfig.social.discord}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
            class="text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
            style={`--accent-color: ${siteConfig.accentColor}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 127.14 96.36"
              fill="currentColor"
              class="h-6 w-6"
            >
              <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
            </svg>
          </a>
          )
        }

        {
          siteConfig.social?.github && (
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
            style={`--accent-color: ${siteConfig.accentColor}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"
              ></path></svg
            >
          </a>
          )
        }
        </div>
      </div>

      <div class="flex flex-col md:items-end gap-4">
        <nav class="flex gap-x-8">
          <a
            href="#about"
            class="text-sm text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
            style={`--accent-color: ${siteConfig.accentColor}`}
            >About</a
          >
          {
            hasProjects && (
              <a
                href="#projects"
                class="text-sm text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
                style={`--accent-color: ${siteConfig.accentColor}`}
              >
                Projects
              </a>
            )
          }
          {
            hasExperience && (
              <a
                href="#experience"
                class="text-sm text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
                style={`--accent-color: ${siteConfig.accentColor}`}
              >
                Experience
              </a>
            )
          }
          {
            hasEducation && (
              <a
                href="#education"
                class="text-sm text-gray-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
                style={`--accent-color: ${siteConfig.accentColor}`}
              >
                Education
              </a>
            )
          }
        </nav>
        <p class="text-sm text-gray-500">
          © {new Date().getFullYear()}
          {siteConfig.name}. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  #footer-grid-spotlight {
    -webkit-mask-image: radial-gradient(
      220px circle at var(--fx, 50%) var(--fy, 50%),
      white,
      transparent 70%
    );
    mask-image: radial-gradient(
      220px circle at var(--fx, 50%) var(--fy, 50%),
      white,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  #footer-symbols-spotlight {
    -webkit-mask-image: radial-gradient(
      140px circle at var(--fx, 50%) var(--fy, 50%),
      white,
      transparent 70%
    );
    mask-image: radial-gradient(
      140px circle at var(--fx, 50%) var(--fy, 50%),
      white,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  #site-footer.is-glowing #footer-grid-spotlight {
    opacity: 0.3;
  }

  #site-footer.is-glowing #footer-symbols-spotlight {
    opacity: 0.55;
  }

  /* Gentle drift so scattered symbols feel alive, like fireflies wandering
     rather than sitting fixed in place. */
  .symbol-float {
    animation-name: symbol-float;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @keyframes symbol-float {
    0%, 100% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(0px, 0px); }
    12.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-5px, -5px); }
    25% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-8px, 1px); }
    37.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(-5px, 6px); }
    50% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(0px, 8px); }
    62.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(5px, 6px); }
    75% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(8px, 1px); }
    87.5% { transform: translate(-50%, -50%) rotate(var(--rot)) translate(5px, -5px); }
  }
</style>

<script>
  const footer = document.getElementById("site-footer");
  if (footer) {
    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;
    let running = false;

    const tick = () => {
      curX += (targetX - curX) * 0.12;
      curY += (targetY - curY) * 0.12;
      footer.style.setProperty("--fx", `${curX}px`);
      footer.style.setProperty("--fy", `${curY}px`);
      if (Math.abs(targetX - curX) > 0.5 || Math.abs(targetY - curY) > 0.5) {
        requestAnimationFrame(tick);
      } else {
        running = false;
      }
    };

    footer.addEventListener("mousemove", (e) => {
      footer.classList.add("is-glowing");
      const rect = footer.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;
      if (!running) {
        curX = targetX;
        curY = targetY;
        running = true;
        requestAnimationFrame(tick);
      }
    });
    footer.addEventListener("mouseleave", () => {
      footer.classList.remove("is-glowing");
    });
  }
</script>